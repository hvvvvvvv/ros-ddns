# Docker Compose injects this file via env_file; ros-ddns does not load .env.
# Copy to .env, chmod 600 .env, and edit every placeholder before compose up.
# Single-quote values to keep literal $ and # characters in Compose env files.
ROS_PASSWORD='replace-with-router-password'
ALI_ACCESS_KEY_ID='replace-with-access-key-id'
ALI_ACCESS_KEY_SECRET='replace-with-access-key-secret'
# Optional: set all three Aliyun values together when using STS credentials.
# ALI_SECURITY_TOKEN='replace-with-sts-security-token'
ROS_DDNS_API_TOKEN='replace-with-a-long-random-api-token'
# Optional host-side WebUI bind. Change the port when 8080 is already in use.
# ROS_DDNS_HTTP_BIND=127.0.0.1:8080
