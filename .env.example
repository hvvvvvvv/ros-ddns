# Docker Compose injects this file via env_file; ros-ddns does not load .env.
# Copy to .env, chmod 600 .env, and edit every placeholder before compose up.
# Values are read when the container first generates /data/config.yaml (and on
# later starts, because the generated config keeps the env references).
# Single-quote values to keep literal $ and # characters in Compose env files.
ROS_PASSWORD='replace-with-router-password'
ALI_ACCESS_KEY_ID='replace-with-access-key-id'
ALI_ACCESS_KEY_SECRET='replace-with-access-key-secret'
# Optional: set all three Aliyun values together when using STS credentials.
# ALI_SECURITY_TOKEN='replace-with-sts-security-token'
ROS_DDNS_API_TOKEN='replace-with-a-long-random-api-token'

# Required for Docker: the generated config must listen on all interfaces so
# the published host port can reach the WebUI. A non-empty token is mandatory.
ROS_DDNS_LISTEN='0.0.0.0:8080'

# Optional log/runtime/state overrides used by the generated configuration.
# ROS_DDNS_LOG_LEVEL='info'
# ROS_DDNS_LOG_FORMAT='text'
# ROS_DDNS_POLL_INTERVAL='10s'
# ROS_DDNS_STABLE_FOR='0s'
# ROS_DDNS_RECONCILE_TIMEOUT='30s'
# ROS_DDNS_VERIFY_INTERVAL='10m'
# ROS_DDNS_SYNC_ON_START='true'
# ROS_DDNS_MAX_BACKOFF='5m'
# ROS_DDNS_STATE_PATH='/data/state.json'

# Optional overrides used by the generated configuration template.
# ROS_DDNS_ROUTEROS_URL='https://192.168.88.1'
# ROS_DDNS_ROUTEROS_USERNAME='admin'
# ROS_DDNS_INTERFACE='pppoe-out1'
# ROS_DDNS_DOMAIN='example.com'
# ROS_DDNS_CA_FILE='/data/router-ca.pem'

# Optional host-side WebUI bind. Change the port when 8080 is already in use.
# ROS_DDNS_HTTP_BIND=127.0.0.1:8080
