# Normalize line endings in the repository and on every checkout: LF only.
# This overrides core.autocrlf so Windows checkouts stay byte-identical to
# Linux/CI checkouts (Go sources, shell scripts and Dockerfiles all want LF).
* text=auto eol=lf

# Binary assets must never be line-ending converted or treated as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
